+/* fsxsilicon: i386 PE code defaults to x87 maths, which is slow under Rosetta (and emulated by x87sidecar);
+ * musl uses double_t = double, so plain SSE2 double arithmetic is exact here. */
+#if defined(__i386__) && defined(__GNUC__) && !defined(__clang__)
+#pragma GCC target("sse2", "fpmath=sse")
+#endif
 
