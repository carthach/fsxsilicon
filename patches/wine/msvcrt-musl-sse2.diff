+/* fsxsilicon: fast paths. The generic wrappers above spill and reload the whole x87 stack around every call
+ * (fxam/fstsw probes, up to 8 stores and loads), which is costly under Rosetta. With the libm built for SSE2
+ * (see libs/musl/src/internal/libm.h), sin/cos/tan/atan/exp/log use at most one x87 register (for return
+ * values) and never reach math_error() for the inputs accepted here, so those calls can go straight through.
+ * The check sees the argument's high word in %eax; anything else (NaN, infinity, range errors) jumps to the
+ * original wrapper with the x87 stack untouched. sqrt of a non-negative finite value is a single fsqrt. */
+#define CREATE_FPU_FUNC1_FAST(name, call, check) \
+    __ASM_GLOBAL_FUNC(name, \
+            "subl    $12, %esp\n\t" \
+            __ASM_CFI(".cfi_adjust_cfa_offset 12\n\t") \
+            "fstl    (%esp)\n\t"   /* copy the argument, keep it in st(0) */ \
+            "movl    4(%esp), %eax\n\t" \
+            check \
+            "fstp    %st(0)\n\t"   /* pop it: the callee takes it from the stack */ \
+            "call    " __ASM_NAME( #call ) "\n\t" \
+            "addl    $12, %esp\n\t" \
+            __ASM_CFI(".cfi_adjust_cfa_offset -12\n\t") \
+            "ret\n" \
+            "9:\n\t" \
+            __ASM_CFI(".cfi_adjust_cfa_offset 12\n\t") \
+            "addl    $12, %esp\n\t" \
+            __ASM_CFI(".cfi_adjust_cfa_offset -12\n\t") \
+            "jmp     " __ASM_NAME( #name "_slow" ))
 
+/* finite */
+#define FPU_CHECK_FINITE "andl $0x7fffffff, %eax\n\tcmpl $0x7ff00000, %eax\n\tjae 9f\n\t"
+/* |x| < 512: exp() can neither overflow nor underflow */
+#define FPU_CHECK_EXP    "andl $0x7fffffff, %eax\n\tcmpl $0x40800000, %eax\n\tjae 9f\n\t"
+/* positive normal number */
+#define FPU_CHECK_LOG    "cmpl $0x00100000, %eax\n\tjl 9f\n\tcmpl $0x7ff00000, %eax\n\tjge 9f\n\t"
+
 CREATE_FPU_FUNC1(_CIacos, acos)
 CREATE_FPU_FUNC1(_CIasin, asin)
-CREATE_FPU_FUNC1(_CIatan, atan)
+CREATE_FPU_FUNC1(_CIatan_slow, atan)
