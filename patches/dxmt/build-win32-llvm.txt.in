[binaries]
c = '@LLVM_MINGW@/llvm-mingw-20260908-ucrt-macos-universal/bin/i686-w64-mingw32-clang'
cpp = '@LLVM_MINGW@/llvm-mingw-20260908-ucrt-macos-universal/bin/i686-w64-mingw32-clang++'
ar = '@LLVM_MINGW@/llvm-mingw-20260908-ucrt-macos-universal/bin/i686-w64-mingw32-ar'
strip = '@LLVM_MINGW@/llvm-mingw-20260908-ucrt-macos-universal/bin/i686-w64-mingw32-strip'
windres = '@LLVM_MINGW@/llvm-mingw-20260908-ucrt-macos-universal/bin/i686-w64-mingw32-windres'

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'windows'
cpu_family = 'x86'
cpu = 'x86'
endian = 'little'
